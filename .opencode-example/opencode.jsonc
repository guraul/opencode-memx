{
  // opencode-memx plugin registration example
  // Copy relevant parts into your opencode.jsonc or opencode.json

  "plugins": {
    "opencode-memx": {
      // Local path to the plugin (after npm install or git clone)
      "path": "./path/to/opencode-memx",

      // Or if published to npm:
      // "from": "npm",
      // "name": "opencode-memx"
    }
  },

  // Optional: configure plugin-specific settings
  "pluginConfig": {
    "opencode-memx": {
      "maxBufferSize": 20,
      "maxLineLimit": 200,
      "temperature": 0.2,
      "maxTokens": 1024,

      // Specify a model for refinement LLM calls.
      // If omitted, OpenCode's default model is used.
      // Example: "refinementModel": "deepseek-v4-flash"
      "refinementModel": "deepseek-v4-flash"
    }
  }
}
